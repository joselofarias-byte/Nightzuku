#!/usr/bin/env bash
set -Eeuo pipefail

repo="$(git rev-parse --show-toplevel)"
git_dir="$(git rev-parse --absolute-git-dir)"
active="$git_dir/llm-work-current"

if [[ ! -s "$active" ]]; then
  cat >&2 <<'MSG'
ERROR: commit blocked because no standard work order is active.
Start one with:
  bash tools/work.sh start --agent <llm> --objective "<objective>"
Do not bypass this guard with --no-verify.
MSG
  exit 1
fi

order="$(cat "$active")"
[[ -f "$order/WORK-ORDER.md" ]] || {
  printf 'ERROR: active work order is invalid: %s\n' "$order" >&2
  exit 1
}

if [[ -f "$order/MODE.txt" && "$(cat "$order/MODE.txt")" == 'light' ]]; then
  cat >&2 <<'MSG'
ERROR: commit blocked because the active work order is read-only (--light).
Finish or abort it, then start a normal work order before modifying/committing code.
MSG
  exit 1
fi

bash "$repo/tools/llm-workflow.sh" checkpoint pre-commit >/dev/null
