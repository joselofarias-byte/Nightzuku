# Usar cuentas separadas y una clave por teléfono u operador.
# Validar con sshd -t antes de recargar.
Match User remote-device-01
    AllowTcpForwarding remote
    PermitListen 127.0.0.1:15555
    GatewayPorts no
    MaxSessions 0
    AllowStreamLocalForwarding no
    X11Forwarding no
    AllowAgentForwarding no
    PermitTTY no
    AuthenticationMethods publickey

Match User remote-operator-01
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:15555
    MaxSessions 0
    AllowStreamLocalForwarding no
    X11Forwarding no
    AllowAgentForwarding no
    PermitTTY no
    AuthenticationMethods publickey

Match all
