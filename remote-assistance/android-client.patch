+    private fun enableAvailability() {
+        if (Build.VERSION.SDK_INT >= 33 && !AvailabilityService.canNotify(this)) {
+            notifications.launch(Manifest.permission.POST_NOTIFICATIONS)
+        } else {
+            activate()
+        }
+    }
+
+    private fun activate() {
+        if (role != AssistRole.DEVICE || !enrolled() || !AvailabilityService.canNotify(this)) {
+            message(R.string.assist_notifications_required)
+            return
+        }
+        preferences.enabled = true
+        try {
+            AvailabilityService.start(this)
+        } catch (_: RuntimeException) {
+            preferences.enabled = false
+            message(R.string.assist_service_error)
+        }
+        render()
+    }
+
+    private fun runNetwork(block: suspend () -> Unit) {
+        if (busy) return
+        busy = true
+        feedback.visibility = View.GONE
+        render()
+        lifecycleScope.launch {
+            try {
+                block()
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: LoginException) {
+                if (error.status == 401 && role == AssistRole.OPERATOR && enrolled()) logOut()
+                message(when (error.status) {
+                    401 -> R.string.assist_password_error
+                    429 -> R.string.assist_login_retry
+                    403 -> R.string.assist_admin_required
+                    409 -> R.string.assist_account_conflict
+                    404 -> R.string.assist_no_devices
+                    else -> R.string.assist_ssh_error
+                })
+            } catch (error: JSchException) {
+                message(sshError(error))
+            } catch (_: Exception) {
+                message(R.string.assist_ssh_error)
+            } finally {
+                busy = false
+                render()
+            }
+        }
+    }
