--- /dev/null
+++ b/app/src/test/java/com/scrcpy/remote/assist/AssistSshTest.kt
@@ -0,0 +1,26 @@
+package com.scrcpy.remote.assist
+
+import com.jcraft.jsch.HostKeyRepository
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AssistSshTest {
+    private val fingerprint = "SHA256:ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0"
+
+    @Test fun verifiesOnlyPinnedHostKey() {
+        val pinned = PinnedHostKey(fingerprint)
+        assertEquals(HostKeyRepository.OK, pinned.check("relay", "abc".toByteArray()))
+        assertEquals(HostKeyRepository.CHANGED, pinned.check("relay", "wrong".toByteArray()))
+    }
+
+    @Test fun acceptsMagicDnsAndTailnetIpv4() {
+        val profile = AssistProfile("relay.tail.example.ts.net", 2222, "remote-device-01", fingerprint, 15555, 5555)
+        assertTrue(profile.isValid())
+        assertTrue(profile.copy(host = "100.64.12.20").isValid())
+        assertFalse(profile.copy(host = "ssh://relay").isValid())
+        assertFalse(profile.copy(fingerprint = "").isValid())
+        assertFalse(profile.copy(relayPort = 99999).isValid())
+    }
+}
