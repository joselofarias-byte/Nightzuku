+    private fun showAccountActions(row: JSONObject) {
+        val username = row.getString("username")
+        val displayName = row.optString("name", username)
+        val enabled = row.getBoolean("enabled")
+        val actions = mutableListOf(
+            getString(R.string.assist_rename), getString(R.string.assist_change_password), getString(R.string.assist_choose_avatar),
+        )
+        if (!row.getBoolean("admin")) actions.add(getString(
+            if (enabled) R.string.assist_disable_account else R.string.assist_enable_account,
+        ))
+        AlertDialog.Builder(this).setTitle(displayName)
+            .setItems(actions.toTypedArray()) { _, index ->
+                when (index) {
+                    0 -> editName(displayName) { name ->
+                        accountRequest("accounts/name", JSONObject().put("username", username).put("name", name))
+                        showAccounts(accountRequest("accounts", JSONObject()))
+                    }
+                    1 -> editAccount(username)
+                    2 -> chooseAvatar(accountAvatarKey(server(), username)) {
+                        updateAvatar()
+                        loadAccounts()
+                    }
+                    else -> confirmAccountStatus(username, !enabled)
+                }
+            }
+            .setNegativeButton(android.R.string.cancel, null).show()
+    }
