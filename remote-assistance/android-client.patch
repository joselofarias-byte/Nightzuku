diff --git a/app/src/main/java/com/scrcpy/remote/assist/AssistSsh.kt b/app/src/main/java/com/scrcpy/remote/assist/AssistSsh.kt
new file mode 100644
index 0000000..46e94de
--- /dev/null
+++ b/app/src/main/java/com/scrcpy/remote/assist/AssistSsh.kt
@@ -0,0 +1,165 @@
+package com.scrcpy.remote.assist
+
+import android.content.Context
+import android.util.AtomicFile
+import java.util.Base64
+import com.jcraft.jsch.HostKey
+import com.jcraft.jsch.HostKeyRepository
+import com.jcraft.jsch.JSch
+import com.jcraft.jsch.KeyPair
+import com.jcraft.jsch.Session
+import com.jcraft.jsch.UserInfo
+import java.io.File
+import java.net.InetSocketAddress
+import java.net.Socket
+import java.security.MessageDigest
+
+internal const val LOOPBACK = "127.0.0.1"
+
+internal enum class AssistRole { OPERATOR, DEVICE }
+
+internal data class AssistProfile(
+    val host: String,
+    val port: Int,
+    val user: String,
+    val fingerprint: String,
+    val relayPort: Int,
+    val adbPort: Int,
+) {
+    fun isValid(): Boolean =
+        host.length in 1..253 && host.matches(Regex("[A-Za-z0-9][A-Za-z0-9.-]*")) &&
+            user.matches(Regex("[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}")) &&
+            fingerprint.matches(Regex("SHA256:[A-Za-z0-9+/]{43}")) &&
+            port in 1..65535 && relayPort in 1024..65535 && adbPort in 1..65535
+}
+
+internal class AssistPreferences(context: Context) {
+    private val prefs = context.getSharedPreferences("remote_assistance", Context.MODE_PRIVATE)
+
+    var enabled: Boolean
+        get() = prefs.getBoolean("enabled", false)
+        set(value) { prefs.edit().putBoolean("enabled", value).apply() }
+
+    fun profile(role: AssistRole): AssistProfile {
+        val key = role.name
+        return AssistProfile(
+            prefs.getString("$key.host", "").orEmpty(),
+            prefs.getInt("$key.port", 22),
+            prefs.getString("$key.user", if (role == AssistRole.DEVICE) "remote-device-01" else "remote-operator-01").orEmpty(),
+            prefs.getString("$key.fingerprint", "").orEmpty(),
+            prefs.getInt("$key.relayPort", 15555),
+            prefs.getInt("$key.adbPort", 5555),
+        )
+    }
+
+    fun save(role: AssistRole, profile: AssistProfile) {
+        val key = role.name
+        prefs.edit()
+            .putString("$key.host", profile.host)
+            .putInt("$key.port", profile.port)
+            .putString("$key.user", profile.user)
+            .putString("$key.fingerprint", profile.fingerprint)
+            .putInt("$key.relayPort", profile.relayPort)
+            .putInt("$key.adbPort", profile.adbPort)
+            .apply()
+    }
+}
+
+internal object AssistSsh {
+    // Private app storage, separate keys for both roles. Only public keys leave the app.
+    @Synchronized
+    fun publicKey(context: Context, role: AssistRole): String {
+        val file = identity(context, role)
+        val key = KeyPair.load(JSch(), file.path)
+        return try {
+            val blob = Base64.getEncoder().encodeToString(key.publicKeyBlob)
+            "ecdsa-sha2-nistp256 $blob jolufasoft-${role.name.lowercase()}"
+        } finally {
+            key.dispose()
+        }
+    }
+
+    @Synchronized
+    private fun identity(context: Context, role: AssistRole): File {
+        val file = File(context.noBackupFilesDir, "assist-${role.name.lowercase()}.key")
+        val atomic = AtomicFile(file)
+        try {
+            atomic.openRead().use { return file }
+        } catch (_: java.io.FileNotFoundException) {
+            val key = KeyPair.genKeyPair(JSch(), KeyPair.ECDSA, 256)
+            try {
+                val output = atomic.startWrite()
+                try {
+                    key.writePrivateKey(output)
+                    atomic.finishWrite(output)
+                } catch (failure: Exception) {
+                    atomic.failWrite(output)
+                    throw failure
+                }
+            } finally {
+                key.dispose()
+            }
+        }
+        return file
+    }
+
+    fun session(context: Context, role: AssistRole, profile: AssistProfile): Session {
+        require(profile.isValid())
+        val ssh = JSch().apply {
+            hostKeyRepository = PinnedHostKey(profile.fingerprint)
+            addIdentity(identity(context, role).path)
+        }
+        return ssh.getSession(profile.user, profile.host, profile.port).apply {
+            setConfig("StrictHostKeyChecking", "yes")
+            setConfig("PreferredAuthentications", "publickey")
+            setConfig("server_host_key", "ecdsa-sha2-nistp256")
+            setServerAliveInterval(15_000)
+            setServerAliveCountMax(3)
+        }
+    }
+
+    fun adbAvailable(port: Int): Boolean = try {
+        Socket().use { it.connect(InetSocketAddress(LOOPBACK, port), 800) }
+        true
+    } catch (_: java.io.IOException) {
+        false
+    }
+}
+
+internal class PinnedHostKey(private val fingerprint: String) : HostKeyRepository {
+    override fun check(host: String, key: ByteArray): Int {
+        val hash = MessageDigest.getInstance("SHA-256").digest(key)
+        val actual = "SHA256:" + Base64.getEncoder().withoutPadding().encodeToString(hash)
+        return if (MessageDigest.isEqual(actual.toByteArray(), fingerprint.toByteArray())) {
+            HostKeyRepository.OK
+        } else {
+            HostKeyRepository.CHANGED
+        }
+    }
+
+    override fun add(hostkey: HostKey, ui: UserInfo?) = Unit
+    override fun remove(host: String, type: String) = Unit
+    override fun remove(host: String, type: String, key: ByteArray) = Unit
+    override fun getKnownHostsRepositoryID(): String = "JolufaSoft Remote"
+    override fun getHostKey(): Array<HostKey> = emptyArray()
+    override fun getHostKey(host: String?, type: String?): Array<HostKey> = emptyArray()
+}
+
+internal object OperatorTunnel {
+    // Accessed on the main thread. The mirror takes ownership until the session ends.
+    private var connection: Pair<Int, Session>? = null
+
+    fun open(port: Int, session: Session) {
+        close()
+        connection = port to session
+    }
+
+    fun isOpen(port: Int): Boolean = connection?.let { it.first == port && it.second.isConnected } == true
+
+    fun close(port: Int? = null) {
+        val current = connection ?: return
+        if (port != null && current.first != port) return
+        connection = null
+        current.second.disconnect()
+    }
+}
diff --git a/app/src/main/java/com/scrcpy/remote/assist/AvailabilityService.kt b/app/src/main/java/com/scrcpy/remote/assist/AvailabilityService.kt
new file mode 100644
index 0000000..65dfb10
--- /dev/null
+++ b/app/src/main/java/com/scrcpy/remote/assist/AvailabilityService.kt
@@ -0,0 +1,168 @@
+package com.scrcpy.remote.assist
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.app.Service
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.os.IBinder
+import androidx.annotation.StringRes
+import androidx.core.app.NotificationManagerCompat
+import androidx.core.app.ServiceCompat
+import androidx.core.content.ContextCompat
+import com.scrcpy.remote.R
+import com.scrcpy.remote.ui.RemoteAssistActivity
+import com.jcraft.jsch.JSchException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+class AvailabilityService : Service() {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var tunnelJob: Job? = null
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        val preferences = AssistPreferences(this)
+        if (intent?.action == ACTION_STOP) preferences.enabled = false
+        val profile = preferences.profile(AssistRole.DEVICE)
+        if (!preferences.enabled || !profile.isValid() || !canNotify(this)) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        if (tunnelJob?.isActive == true) return START_STICKY
+        ServiceCompat.startForeground(
+            this, NOTIFICATION_ID, notification(R.string.assist_connecting),
+            ServiceInfo.FOREGROUND_SERVICE_TYPE_CONNECTED_DEVICE,
+        )
+        tunnelJob = scope.launch { keepAvailable(profile) }
+        return START_STICKY
+    }
+
+    private suspend fun keepAvailable(profile: AssistProfile) {
+        var retryDelay = 2_000L
+        while (canNotify(this)) {
+            if (!AssistSsh.adbAvailable(profile.adbPort)) {
+                publish(R.string.assist_wait_adb)
+                delay(5_000)
+                continue
+            }
+            val session = try {
+                AssistSsh.session(this, AssistRole.DEVICE, profile)
+            } catch (_: Exception) {
+                publish(R.string.assist_key_error)
+                delay(30_000)
+                continue
+            }
+            try {
+                publish(R.string.assist_connecting)
+                session.connect(12_000)
+                currentCoroutineContext().ensureActive()
+                session.setPortForwardingR(LOOPBACK, profile.relayPort, LOOPBACK, profile.adbPort)
+                retryDelay = 2_000L
+                publish(R.string.assist_available)
+                while (session.isConnected && canNotify(this)) delay(2_000)
+            } catch (failure: JSchException) {
+                currentCoroutineContext().ensureActive()
+                publish(sshError(failure))
+            } finally {
+                session.disconnect()
+            }
+            delay(retryDelay)
+            retryDelay = (retryDelay * 2).coerceAtMost(60_000)
+        }
+        stopSelf()
+    }
+
+    private fun publish(@StringRes state: Int) {
+        _status.value = state
+        getSystemService(NotificationManager::class.java).notify(NOTIFICATION_ID, notification(state))
+    }
+
+    private fun notification(@StringRes state: Int): Notification {
+        val open = PendingIntent.getActivity(this, 0, Intent(this, RemoteAssistActivity::class.java),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        val stop = PendingIntent.getService(this, 1,
+            Intent(this, AvailabilityService::class.java).setAction(ACTION_STOP),
+            PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        return Notification.Builder(this, CHANNEL_ID)
+            .setSmallIcon(android.R.drawable.stat_sys_upload)
+            .setContentTitle(getString(R.string.assist_notification_title))
+            .setContentText(getString(state))
+            .setContentIntent(open)
+            .setCategory(Notification.CATEGORY_SERVICE)
+            .setOnlyAlertOnce(true)
+            .setOngoing(true)
+            .addAction(Notification.Action.Builder(null, getString(R.string.assist_disable), stop).build())
+            .build()
+    }
+
+    override fun onDestroy() {
+        scope.cancel()
+        stopForeground(STOP_FOREGROUND_REMOVE)
+        _status.value = R.string.assist_disabled
+        super.onDestroy()
+    }
+
+    companion object {
+        private const val NOTIFICATION_ID = 15555
+        private const val CHANNEL_ID = "remote_assist_availability"
+        private const val ACTION_STOP = "com.jolufasoft.remote.STOP_ASSISTANCE"
+        private val _status = MutableStateFlow(R.string.assist_disabled)
+        internal val status = _status.asStateFlow()
+
+        internal fun canNotify(context: Context): Boolean {
+            val manager = context.getSystemService(NotificationManager::class.java)
+            manager.createNotificationChannel(NotificationChannel(CHANNEL_ID,
+                context.getString(R.string.assist_notification_title), NotificationManager.IMPORTANCE_LOW))
+            val importance = manager.getNotificationChannel(CHANNEL_ID)?.importance ?: NotificationManager.IMPORTANCE_NONE
+            return NotificationManagerCompat.from(context).areNotificationsEnabled() &&
+                importance != NotificationManager.IMPORTANCE_NONE
+        }
+
+        internal fun start(context: Context) {
+            ContextCompat.startForegroundService(context, Intent(context, AvailabilityService::class.java))
+        }
+
+        internal fun stop(context: Context) {
+            AssistPreferences(context).enabled = false
+            context.stopService(Intent(context, AvailabilityService::class.java))
+        }
+    }
+}
+
+class AssistanceBootReceiver : BroadcastReceiver() {
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_BOOT_COMPLETED) return
+        if (AssistPreferences(context).enabled && AvailabilityService.canNotify(context)) {
+            runCatching { AvailabilityService.start(context) }
+        }
+    }
+}
+
+@StringRes
+internal fun sshError(failure: JSchException): Int {
+    val message = failure.message.orEmpty()
+    return when {
+        "HostKey" in message || "hostkey" in message.lowercase() ->
+            R.string.assist_host_key_error
+        "Auth fail" in message || "USERAUTH" in message ->
+            R.string.assist_auth_error
+        "remote port forwarding" in message ->
+            R.string.assist_forward_error
+        else -> R.string.assist_ssh_error
+    }
+}
