+    private fun updateCustomServers(existing: String?, host: String?) {
+        val remaining = customServers() - existing.orEmpty()
+        val primary = RelayLogin.displayServer("")
+        val saved = if (host == null || host == primary || host == RelayLogin.TAILSCALE_SERVER) remaining else remaining + host
+        val edit = login.edit().putStringSet("customServers", saved)
+        if (existing != null && login.getString("lastServer", "") == existing) {
+            edit.putString("lastServer", host ?: primary)
+        }
+        edit.apply()
+        if (!enrolled() && existing != null && selectedServer == existing) {
+            updateSelectedServer(host ?: primary)
+            passwordInput.setText("")
+        }
+    }
