diff --git a/app/src/main/java/com/scrcpy/remote/ui/RemoteAssistActivity.kt b/app/src/main/java/com/scrcpy/remote/ui/RemoteAssistActivity.kt
new file mode 100644
index 0000000..bf548cc
--- /dev/null
+++ b/app/src/main/java/com/scrcpy/remote/ui/RemoteAssistActivity.kt
@@ -0,0 +1,73 @@
+package com.scrcpy.remote.ui
+
+import android.app.AlertDialog
+import android.os.Bundle
+import android.text.InputType
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import androidx.activity.ComponentActivity
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.updatePadding
+import com.scrcpy.remote.R
+
+/** A session is started by the operator through a loopback SSH forward. */
+class RemoteAssistActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val preferences = getSharedPreferences("remote_assistance", MODE_PRIVATE)
+        val padding = (resources.displayMetrics.density * 24).toInt()
+        val layout = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(padding, padding, padding, padding)
+        }
+        layout.addView(TextView(this).apply {
+            setText(R.string.app_name)
+            textSize = 26f
+        })
+        layout.addView(TextView(this).apply {
+            setText(R.string.assist_help)
+            textSize = 16f
+            setPadding(0, padding, 0, padding)
+        })
+        val portInput = EditText(this).apply {
+            id = R.id.assist_port
+            inputType = InputType.TYPE_CLASS_NUMBER
+            setSingleLine()
+            setHint(R.string.assist_port_hint)
+            contentDescription = getString(R.string.assist_port_hint)
+            setText(preferences.getInt("port", 15556).toString())
+        }
+        layout.addView(portInput)
+        layout.addView(Button(this).apply {
+            setText(R.string.connect)
+            setOnClickListener {
+                val port = portInput.text.toString().toIntOrNull()
+                if (port == null || port !in 1..65535) {
+                    portInput.error = getString(R.string.assist_port_error)
+                    return@setOnClickListener
+                }
+                AlertDialog.Builder(this@RemoteAssistActivity)
+                    .setTitle(R.string.assist_confirm_title)
+                    .setMessage(R.string.assist_confirm_body)
+                    .setNegativeButton(android.R.string.cancel, null)
+                    .setPositiveButton(R.string.connect) { _, _ ->
+                        preferences.edit().putInt("port", port).apply()
+                        startActivity(MirrorActivity.newIntent(this@RemoteAssistActivity, "127.0.0.1", port))
+                    }.show()
+            }
+        })
+        val page = ScrollView(this).apply { addView(layout) }
+        ViewCompat.setOnApplyWindowInsetsListener(page) { view, insets ->
+            val safe = insets.getInsets(
+                WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout(),
+            )
+            view.updatePadding(left = safe.left, top = safe.top, right = safe.right, bottom = safe.bottom)
+            insets
+        }
+        setContentView(page)
+    }
+}
