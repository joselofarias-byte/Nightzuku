+    private fun verifyLockSettings() {
+        val lock = AppLock(this)
+        when (lock.mode) {
+            AppLock.Mode.OFF -> showLockSettings(lock)
+            AppLock.Mode.ANDROID -> authenticateAndroid({ showLockSettings(lock) }) {
+                message(R.string.assist_auth_unavailable)
+            }
+            else -> {
+                val input = lockSecretField(this, lock.mode, R.string.assist_unlock_secret)
+                val dialog = AlertDialog.Builder(this)
+                    .setTitle(R.string.assist_confirm_lock).setView(input)
+                    .setPositiveButton(android.R.string.ok, null)
+                    .setNegativeButton(android.R.string.cancel, null).create()
+                dialog.setOnShowListener {
+                    val confirm = dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                    confirm.setOnClickListener {
+                        confirm.isEnabled = false
+                        val secret = input.text.toString()
+                        lifecycleScope.launch {
+                            if (withContext(Dispatchers.Default) { lock.verify(secret) }) {
+                                dialog.dismiss()
+                                showLockSettings(lock)
+                            } else {
+                                input.error = lockError(lock)
+                                confirm.isEnabled = true
+                            }
+                        }
+                    }
+                }
+                dialog.show()
+            }
+        }
+    }
+
+    private fun showLockSettings(lock: AppLock) {
+        val choices = AppLock.Mode.entries.filter { it != AppLock.Mode.ANDROID || canUseAndroidLock() }
+        val texts = choices.map {
+            getString(when (it) {
+                AppLock.Mode.OFF -> R.string.assist_lock_off
+                AppLock.Mode.PIN -> R.string.assist_lock_pin
+                AppLock.Mode.PASSWORD -> R.string.assist_lock_password
+                AppLock.Mode.ANDROID -> R.string.assist_unlock_android
+            })
+        }
+        AlertDialog.Builder(this).setTitle(R.string.assist_local_lock)
+            .setSingleChoiceItems(texts.toTypedArray(), choices.indexOf(lock.mode)) { dialog, which ->
+                dialog.dismiss()
+                when (val selection = choices[which]) {
+                    AppLock.Mode.PIN, AppLock.Mode.PASSWORD -> showSetLockSecret(lock, selection)
+                    AppLock.Mode.ANDROID -> authenticateAndroid({ applyLock(lock, selection) }) {
+                        message(R.string.assist_auth_unavailable)
+                    }
+                    AppLock.Mode.OFF -> applyLock(lock, selection)
+                }
+            }
+            .setNegativeButton(android.R.string.cancel, null).show()
+    }
+
+    private fun showSetLockSecret(lock: AppLock, mode: AppLock.Mode) {
+        val fields = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(20), dp(8), dp(20), dp(8))
+        }
+        val input = lockSecretField(this, mode, R.string.assist_unlock_secret)
+        val confirmation = lockSecretField(this, mode, R.string.assist_confirm_local_secret)
+        fields.addView(input)
+        fields.addView(confirmation)
+        val dialog = AlertDialog.Builder(this)
+            .setTitle(if (mode == AppLock.Mode.PIN) R.string.assist_lock_pin else R.string.assist_lock_password)
+            .setView(fields).setPositiveButton(R.string.assist_save_account, null)
+            .setNegativeButton(android.R.string.cancel, null).create()
+        dialog.setOnShowListener {
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val value = input.text.toString()
+                when {
+                    !AppLock.valid(mode, value) -> input.error = getString(
+                        if (mode == AppLock.Mode.PIN) R.string.assist_pin_rule else R.string.assist_local_password_rule,
+                    )
+                    value != confirmation.text.toString() -> confirmation.error = getString(R.string.assist_password_mismatch)
+                    else -> {
+                        dialog.dismiss()
+                        applyLock(lock, mode, value)
+                    }
+                }
+            }
+        }
+        dialog.show()
+    }
+
+    private fun applyLock(lock: AppLock, mode: AppLock.Mode, value: String? = null) {
+        runNetwork {
+            withContext(Dispatchers.Default) { lock.configure(mode, value) }
+            AppLock.unlocked = lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)
+            updateRecentsProtection(mode != AppLock.Mode.OFF)
+            message(R.string.assist_lock_saved)
+        }
+    }
+
+    private fun message(@StringRes text: Int) {
+        feedback.setText(text)
+        feedback.visibility = View.VISIBLE
+    }
+
+    private fun dp(value: Int): Int = (value * resources.displayMetrics.density).toInt()
+
+    private fun shape(fill: Int, radius: Int = 12, border: Int? = null) = GradientDrawable().apply {
+        setColor(getColor(fill))
+        cornerRadius = dp(radius).toFloat()
+        if (border != null) setStroke(dp(1), getColor(border))
+    }
+
+    private fun label(@StringRes text: Int, size: Float, bold: Boolean = false, tone: Int = R.color.assist_text) =
+        TextView(this).apply {
+            setText(text)
+            textSize = size
+            setTextColor(getColor(tone))
+            if (bold) setTypeface(typeface, Typeface.BOLD)
+        }
+
+    private fun LinearLayout.card(): LinearLayout = LinearLayout(this@RemoteAssistActivity).apply {
+        orientation = LinearLayout.VERTICAL
+        background = shape(R.color.assist_surface, radius = 18, border = R.color.assist_border)
+        setPadding(dp(16), dp(16), dp(16), dp(16))
+        this@card.addView(this, LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(14) })
+    }
+
+    private fun LinearLayout.mode(@StringRes title: Int, mode: AssistRole): RadioButton =
+        RadioButton(this@RemoteAssistActivity).apply {
+            setText(title)
+            setTextColor(getColor(R.color.assist_text))
+            textSize = 16f
+            minHeight = dp(50)
+            buttonTintList = ColorStateList.valueOf(getColor(R.color.assist_accent))
+            compoundDrawablePadding = dp(10)
+            setOnClickListener { chooseRole(mode) }
+            this@mode.addView(this, LinearLayout.LayoutParams(-1, -2))
+        }
+
+    private fun updateMode(button: RadioButton, selected: Boolean) {
+        button.isChecked = selected
+        button.isEnabled = !busy
+        button.background = RippleDrawable(
+            ColorStateList.valueOf(getColor(R.color.assist_border)),
+            shape(if (selected) R.color.assist_selected else R.color.assist_surface), null,
+        )
+    }
+
+    private fun LinearLayout.button(@StringRes text: Int, primary: Boolean = false, callback: () -> Unit): Button =
+        Button(this@RemoteAssistActivity).apply {
+            setText(text)
+            isAllCaps = false
+            setTextColor(getColor(if (primary) R.color.assist_on_accent else R.color.assist_accent))
+            textSize = 15f
+            minHeight = dp(48)
+            setPadding(dp(12), dp(8), dp(12), dp(8))
+            gravity = Gravity.CENTER
+            background = RippleDrawable(
+                ColorStateList.valueOf(getColor(R.color.assist_border)),
+                shape(if (primary) R.color.assist_accent else R.color.assist_surface), null,
+            )
+            setOnClickListener { callback() }
+            this@button.addView(this, LinearLayout.LayoutParams(-1, -2).apply { topMargin = dp(8) })
+        }
+
+    private fun LinearLayout.field(@StringRes title: Int, type: Int): EditText {
+        val row = LinearLayout(this@RemoteAssistActivity).apply { orientation = LinearLayout.VERTICAL }
+        addView(row, LinearLayout.LayoutParams(-1, -2).apply { topMargin = dp(14) })
+        val input = EditText(this@RemoteAssistActivity).apply {
+            id = View.generateViewId()
+            setSingleLine()
+            inputType = type
+            if (type == PASSWORD_INPUT) transformationMethod = PasswordTransformationMethod.getInstance()
+            isSaveEnabled = false
+            textSize = 16f
+            setTextColor(getColor(R.color.assist_text))
+            setPadding(dp(12), dp(8), dp(12), dp(8))
+            minHeight = dp(50)
+            background = shape(R.color.assist_input, border = R.color.assist_border)
+        }
+        row.addView(label(title, 14f, bold = true).apply {
+            labelFor = input.id
+            setPadding(0, 0, 0, dp(6))
+        })
+        row.addView(input, LinearLayout.LayoutParams(-1, -2))
+        return input
+    }
+
+    private fun passwordVisible(): Boolean = passwordInput.transformationMethod !is PasswordTransformationMethod
+
+    private fun setPasswordVisible(visible: Boolean) {
+        if (visible) window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        else window.clearFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        passwordInput.transformationMethod = if (visible) null else PasswordTransformationMethod.getInstance()
+        passwordInput.setSelection(passwordInput.text.length)
+        passwordReveal.setText(if (visible) R.string.assist_hide_password else R.string.assist_show_password)
+    }
+
+    companion object {
+        private const val PASSWORD_INPUT = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+        private val USERNAME = Regex("[a-z][a-z0-9_.-]{2,31}")
+        private val RANDOM = SecureRandom()
+        private const val GENERATION_CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789!#%+@"
+        private val STRENGTH_LABELS = intArrayOf(
+            R.string.assist_strength_empty, R.string.assist_strength_weak,
+            R.string.assist_strength_medium, R.string.assist_strength_strong,
+        )
+
+        internal fun passwordStrength(password: String): Int {
+            val length = password.codePointCount(0, password.length)
+            val groups = listOf(
+                password.any(Char::isUpperCase), password.any(Char::isLowerCase),
+                password.any(Char::isDigit), password.any { !it.isLetterOrDigit() && !it.isWhitespace() },
+            ).count { it }
+            return when {
+                length == 0 -> 0
+                length < 12 || password.toSet().size < 5 -> 1
+                (length >= 16 && groups >= 3) || (length >= 20 && password.toSet().size >= 10) -> 3
+                else -> 2
+            }
+        }
+    }
+}
