+    private fun connect(id: String) {
+        val host = server()
+        val auth = token()
+        runNetwork {
+            var pending: Session? = null
+            try {
+                val port = withContext(Dispatchers.IO) {
+                    val response = RelayLogin.request(host, "connect", JSONObject().put("id", id), auth)
+                    val profile: AssistProfile = RelayLogin.profile(response, host, account(AssistRole.OPERATOR), auth)
+                    val session = AssistSsh.session(applicationContext, AssistRole.OPERATOR, profile)
+                    pending = session
+                    session.connect(12_000)
+                    session.setPortForwardingL(LOOPBACK, 0, LOOPBACK, profile.relayPort)
+                }
+                OperatorTunnel.open(port, checkNotNull(pending))
+                pending = null
+                startActivity(MirrorActivity.newIntent(this@RemoteAssistActivity, LOOPBACK, port))
+            } finally {
+                pending?.disconnect()
+            }
+        }
+    }
