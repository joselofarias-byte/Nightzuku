+    private fun showAccounts(response: JSONObject) {
+        val entries = response.getJSONArray("accounts")
+        val rows = (0 until entries.length()).map { entries.getJSONObject(it) }
+        val avatars = rows.map { row ->
+            val fallback = if (row.getString("role") == account(AssistRole.DEVICE)) ProfileAvatar.CAT else ProfileAvatar.ROBOT
+            savedAvatar(accountAvatarKey(server(), row.getString("username")), fallback)
+        }
+        val labels = rows.map { row ->
+            val roleLabel = when {
+                row.getBoolean("admin") -> R.string.assist_admin
+                row.getString("role") == account(AssistRole.OPERATOR) -> R.string.assist_operator
+                else -> R.string.assist_device
+            }
+            val state = if (row.getBoolean("enabled")) R.string.assist_account_active else R.string.assist_account_inactive
+            val username = row.getString("username")
+            val display = row.optString("name", username)
+            val identity = if (display == username) username else "$display ($username)"
+            "$identity · ${getString(roleLabel)} · ${getString(state)}"
+        }
+        chooseFrom(R.string.assist_accounts, labels, R.string.assist_account_actions, R.string.assist_create_account,
+            onSelect = { showAccountActions(rows[it]) },
+            onAlternate = { editAccount(null) }, avatars = avatars,
+        )
+    }
