@@ -0,0 +1,61 @@
+package com.scrcpy.remote.assist
+
+import com.scrcpy.remote.BuildConfig
+import org.json.JSONObject
+import java.io.IOException
+import java.net.URL
+import javax.net.ssl.HttpsURLConnection
+
+internal class LoginException(val status: Int) : IOException()
+
+internal object RelayLogin {
+    const val DEFAULT_ALIAS = "remoto"
+    const val TAILSCALE_SERVER = "jolufa-a1-always-free-2cpu-12gb.tailf7133f.ts.net"
+
+    fun resolveServer(input: String, defaultServer: String = BuildConfig.ASSIST_DEFAULT_SERVER): String {
+        val host = input.trim().lowercase()
+        return if (host == DEFAULT_ALIAS && validServer(defaultServer)) defaultServer else host
+    }
+
+    fun displayServer(server: String): String =
+        resolveServer(server.ifBlank { DEFAULT_ALIAS })
+
+    fun validServer(host: String): Boolean =
+        host.length in 4..253 && '.' in host && host.last().isLetter() &&
+            host.split('.').all { it.matches(Regex("[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?")) }
+
+    fun usesWebSocket(server: String): Boolean = !server.endsWith(".ts.net")
+
+    fun request(server: String, path: String, body: JSONObject, token: String = ""): JSONObject {
+        require(validServer(server))
+        val port = if (usesWebSocket(server)) 443 else 8443
+        val connection = URL("https://$server:$port/jremote/$path").openConnection() as HttpsURLConnection
+        return try {
+            connection.requestMethod = "POST"
+            connection.instanceFollowRedirects = false
+            connection.connectTimeout = 8_000
+            connection.readTimeout = 10_000
+            connection.doOutput = true
+            connection.setRequestProperty("Content-Type", "application/json")
+            if (token.isNotEmpty()) connection.setRequestProperty("Authorization", "Bearer $token")
+            connection.outputStream.use { it.write(body.toString().toByteArray(Charsets.UTF_8)) }
+            val status = connection.responseCode
+            if (status != 200) throw LoginException(status)
+            JSONObject(connection.inputStream.bufferedReader(Charsets.UTF_8).use { it.readText() })
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    fun profile(response: JSONObject, server: String, user: String, token: String = ""): AssistProfile {
+        val webSocket = usesWebSocket(server)
+        val profile = AssistProfile(
+            response.getString("host"), response.getInt("port"), user,
+            response.getString("fingerprint"), response.getInt("relayPort"), 5555,
+            if (webSocket) server else "",
+            if (webSocket) response.optString("tunnelToken", token) else "",
+        )
+        check((webSocket || profile.host == server) && profile.isValid())
+        return profile
+    }
+}
diff --git a/app/src/main/java/com/scrcpy/remote/assist/RelayWebSocket.kt b/app/src/main/java/com/scrcpy/remote/assist/RelayWebSocket.kt
new file mode 100644
index 0000000..ecf001d
--- /dev/null
+++ b/app/src/main/java/com/scrcpy/remote/assist/RelayWebSocket.kt
@@ -0,0 +1,116 @@
+package com.scrcpy.remote.assist
+
+import com.jcraft.jsch.SocketFactory
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.WebSocket
+import okhttp3.WebSocketListener
+import okio.ByteString
+import okio.ByteString.Companion.toByteString
+import java.io.IOException
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.ServerSocket
+import java.net.Socket
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicReference
+
+/** Adapts an authenticated WSS byte stream to the Socket used by the existing SSH client. */
+internal class RelayWebSocket(host: String, role: AssistRole, token: String) : SocketFactory {
+    private val request = Request.Builder()
+        .url("wss://$host/jremote/tunnel")
+        .header("Authorization", "Bearer $token")
+        .header("X-Jremote-Role", role.name.lowercase())
+        .build()
+
+    override fun createSocket(host: String, port: Int): Socket {
+        val peer = AtomicReference<Socket>()
+        val active = AtomicReference<WebSocket>()
+        val closed = AtomicBoolean()
+        val socket = object : Socket() {
+            override fun close() {
+                if (!closed.compareAndSet(false, true)) return
+                active.get()?.cancel()
+                runCatching { peer.get()?.close() }
+                super.close()
+            }
+        }
+        try {
+            val relay = ServerSocket(0, 1, InetAddress.getByName(LOOPBACK)).use { listener ->
+                listener.soTimeout = 1_000
+                socket.connect(InetSocketAddress(LOOPBACK, listener.localPort), 1_000)
+                listener.accept().also {
+                    if (it.port != socket.localPort) {
+                        it.close()
+                        throw IOException("Incorrect loopback peer")
+                    }
+                }
+            }
+            peer.set(relay)
+            relay.tcpNoDelay = true
+            val ready = CountDownLatch(1)
+            val opened = AtomicBoolean()
+            val webSocket = HTTP.newWebSocket(request, object : WebSocketListener() {
+                override fun onOpen(webSocket: WebSocket, response: Response) {
+                    opened.set(true)
+                    ready.countDown()
+                }
+
+                override fun onMessage(webSocket: WebSocket, bytes: ByteString) {
+                    try {
+                        relay.getOutputStream().write(bytes.toByteArray())
+                    } catch (_: IOException) {
+                        socket.close()
+                    }
+                }
+
+                override fun onMessage(webSocket: WebSocket, text: String) = socket.close()
+                override fun onClosing(webSocket: WebSocket, code: Int, reason: String) = socket.close()
+                override fun onFailure(webSocket: WebSocket, t: Throwable, response: Response?) {
+                    ready.countDown()
+                    socket.close()
+                }
+            })
+            active.set(webSocket)
+            if (!ready.await(10, TimeUnit.SECONDS) || !opened.get() || socket.isClosed) {
+                webSocket.cancel()
+                throw IOException("WebSocket relay unavailable")
+            }
+            Thread({
+                try {
+                    val input = relay.getInputStream()
+                    val buffer = ByteArray(32_768)
+                    while (!socket.isClosed) {
+                        val n = input.read(buffer)
+                        if (n < 0) break
+                        while (!socket.isClosed && webSocket.queueSize() > 1_048_576) Thread.sleep(10)
+                        if (!webSocket.send(buffer.toByteString(0, n))) break
+                    }
+                } catch (_: IOException) {
+                    // Closing either side also interrupts the local socket read.
+                } finally {
+                    socket.close()
+                }
+            }, "assist-wss").apply { isDaemon = true }.start()
+            return socket
+        } catch (error: Exception) {
+            socket.close()
+            throw error
+        }
+    }
+
+    override fun getInputStream(socket: Socket) = socket.getInputStream()
+    override fun getOutputStream(socket: Socket) = socket.getOutputStream()
+
+    companion object {
+        private val HTTP = OkHttpClient.Builder()
+            .connectTimeout(8, TimeUnit.SECONDS)
+            .followRedirects(false)
+            .followSslRedirects(false)
+            .pingInterval(20, TimeUnit.SECONDS)
+            .build()
+    }
+}
