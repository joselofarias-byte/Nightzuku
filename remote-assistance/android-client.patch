diff --git a/app/src/main/java/com/scrcpy/remote/ui/RemoteAssistActivity.kt b/app/src/main/java/com/scrcpy/remote/ui/RemoteAssistActivity.kt
new file mode 100644
index 0000000..d7234cb
--- /dev/null
+++ b/app/src/main/java/com/scrcpy/remote/ui/RemoteAssistActivity.kt
@@ -0,0 +1,262 @@
+package com.scrcpy.remote.ui
+
+import android.Manifest
+import android.app.AlertDialog
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.os.Build
+import android.os.Bundle
+import android.text.InputType
+import android.widget.Button
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import androidx.activity.ComponentActivity
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.annotation.StringRes
+import androidx.core.view.ViewCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.updatePadding
+import androidx.lifecycle.lifecycleScope
+import com.jcraft.jsch.JSchException
+import com.jcraft.jsch.Session
+import com.scrcpy.remote.R
+import com.scrcpy.remote.assist.AssistPreferences
+import com.scrcpy.remote.assist.AssistProfile
+import com.scrcpy.remote.assist.AssistRole
+import com.scrcpy.remote.assist.AssistSsh
+import com.scrcpy.remote.assist.AvailabilityService
+import com.scrcpy.remote.assist.LOOPBACK
+import com.scrcpy.remote.assist.OperatorTunnel
+import com.scrcpy.remote.assist.sshError
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+class RemoteAssistActivity : ComponentActivity() {
+    private val preferences by lazy { AssistPreferences(this) }
+    private var role = AssistRole.OPERATOR
+    private var connecting = false
+    private lateinit var status: TextView
+    private lateinit var primary: Button
+    private lateinit var operator: Button
+    private lateinit var device: Button
+    private lateinit var host: EditText
+    private lateinit var port: EditText
+    private lateinit var user: EditText
+    private lateinit var fingerprint: EditText
+    private lateinit var relayPort: EditText
+    private lateinit var adbPort: EditText
+    private var formFields: List<EditText> = emptyList()
+
+    private val notifications = registerForActivityResult(ActivityResultContracts.RequestPermission()) { allowed ->
+        if (allowed) enableAvailability() else showMessage(R.string.assist_notifications_required)
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        role = savedInstanceState?.getString("role")?.let(AssistRole::valueOf)
+            ?: if (preferences.enabled) AssistRole.DEVICE else AssistRole.OPERATOR
+        val padding = (resources.displayMetrics.density * 24).toInt()
+        val layout = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(padding, padding, padding, padding)
+            isFocusableInTouchMode = true
+        }
+        layout.addView(TextView(this).apply { setText(R.string.app_name); textSize = 26f })
+        operator = layout.button(R.string.assist_operator) { switchRole(AssistRole.OPERATOR) }
+        device = layout.button(R.string.assist_device) { switchRole(AssistRole.DEVICE) }
+        status = TextView(this).also { layout.addView(it) }
+        host = layout.input(R.string.assist_host, InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_URI)
+        port = layout.input(R.string.assist_ssh_port, InputType.TYPE_CLASS_NUMBER)
+        user = layout.input(R.string.assist_ssh_user)
+        fingerprint = layout.input(R.string.assist_fingerprint)
+        relayPort = layout.input(R.string.assist_relay_port, InputType.TYPE_CLASS_NUMBER)
+        adbPort = layout.input(R.string.assist_adb_port, InputType.TYPE_CLASS_NUMBER)
+        formFields = listOf(host, port, user, fingerprint, relayPort, adbPort)
+        layout.button(R.string.assist_show_key, ::showPublicKey)
+        primary = layout.button(R.string.connect, ::submit)
+        val page = ScrollView(this).apply { addView(layout) }
+        ViewCompat.setOnApplyWindowInsetsListener(page) { view, insets ->
+            val safe = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout())
+            view.updatePadding(left = safe.left, top = safe.top, right = safe.right, bottom = safe.bottom)
+            insets
+        }
+        setContentView(page)
+        loadProfile()
+        lifecycleScope.launch { AvailabilityService.status.collect { updateControls() } }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        updateControls()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        outState.putString("role", role.name)
+        super.onSaveInstanceState(outState)
+    }
+
+    private fun switchRole(next: AssistRole) {
+        if (role == next) return
+        role = next
+        loadProfile()
+    }
+
+    private fun loadProfile() {
+        val profile = preferences.profile(role)
+        host.setText(profile.host)
+        port.setText(profile.port.toString())
+        user.setText(profile.user)
+        fingerprint.setText(profile.fingerprint)
+        relayPort.setText(profile.relayPort.toString())
+        adbPort.setText(profile.adbPort.toString())
+        updateControls()
+    }
+
+    private fun updateControls() {
+        val assisted = role == AssistRole.DEVICE
+        val enabled = preferences.enabled
+        operator.isEnabled = assisted && !connecting
+        device.isEnabled = !assisted && !connecting
+        adbPort.visibility = if (assisted) android.view.View.VISIBLE else android.view.View.GONE
+        formFields.forEach { it.isEnabled = !connecting && !(assisted && enabled) }
+        status.setText(when {
+            assisted && enabled && AvailabilityService.status.value == R.string.assist_disabled ->
+                R.string.assist_ready_to_resume
+            assisted && enabled -> AvailabilityService.status.value
+            assisted -> R.string.assist_disabled
+            connecting -> R.string.assist_connecting
+            else -> R.string.assist_operator_help
+        })
+        primary.setText(when {
+            assisted && enabled -> R.string.assist_disable
+            assisted -> R.string.assist_enable
+            else -> R.string.connect
+        })
+        primary.isEnabled = !connecting
+    }
+
+    private fun submit() {
+        val selectedRole = role
+        if (selectedRole == AssistRole.DEVICE && preferences.enabled) {
+            AvailabilityService.stop(this)
+            updateControls()
+            return
+        }
+        val profile = AssistProfile(
+            host.text.toString().trim(), port.text.toString().toIntOrNull() ?: 0,
+            user.text.toString().trim(), fingerprint.text.toString().trim(),
+            relayPort.text.toString().toIntOrNull() ?: 0, adbPort.text.toString().toIntOrNull() ?: 0,
+        )
+        if (!profile.isValid()) {
+            showMessage(R.string.assist_invalid)
+            return
+        }
+        preferences.save(selectedRole, profile)
+        if (selectedRole == AssistRole.OPERATOR) {
+            connectOperator(profile)
+        } else {
+            AlertDialog.Builder(this)
+                .setTitle(R.string.assist_enable)
+                .setMessage(R.string.assist_consent)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.assist_enable) { _, _ ->
+                    if (Build.VERSION.SDK_INT >= 33 && !AvailabilityService.canNotify(this)) {
+                        notifications.launch(Manifest.permission.POST_NOTIFICATIONS)
+                    } else {
+                        enableAvailability()
+                    }
+                }.show()
+        }
+    }
+
+    private fun enableAvailability() {
+        if (!AvailabilityService.canNotify(this)) {
+            showMessage(R.string.assist_notifications_required)
+            return
+        }
+        preferences.enabled = true
+        try {
+            AvailabilityService.start(this)
+        } catch (_: IllegalStateException) {
+            preferences.enabled = false
+            showMessage(R.string.assist_service_error)
+        } catch (_: SecurityException) {
+            preferences.enabled = false
+            showMessage(R.string.assist_service_error)
+        }
+        updateControls()
+    }
+
+    private fun showPublicKey() {
+        val selectedRole = role
+        lifecycleScope.launch {
+            val key = withContext(Dispatchers.IO) {
+                runCatching { AssistSsh.publicKey(applicationContext, selectedRole) }.getOrNull()
+            }
+            if (key == null) {
+                showMessage(R.string.assist_key_error)
+                return@launch
+            }
+            AlertDialog.Builder(this@RemoteAssistActivity)
+                .setTitle(R.string.assist_show_key)
+                .setMessage(key)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.assist_copy_key) { _, _ ->
+                    getSystemService(ClipboardManager::class.java)
+                        .setPrimaryClip(ClipData.newPlainText(getString(R.string.assist_show_key), key))
+                }.show()
+        }
+    }
+
+    private fun connectOperator(profile: AssistProfile) {
+        connecting = true
+        updateControls()
+        lifecycleScope.launch {
+            var pending: Session? = null
+            try {
+                val forward = withContext(Dispatchers.IO) {
+                    val session = AssistSsh.session(applicationContext, AssistRole.OPERATOR, profile)
+                    pending = session
+                    session.connect(12_000)
+                    session.setPortForwardingL(LOOPBACK, 0, LOOPBACK, profile.relayPort)
+                }
+                OperatorTunnel.open(forward, checkNotNull(pending))
+                pending = null
+                startActivity(MirrorActivity.newIntent(this@RemoteAssistActivity, LOOPBACK, forward))
+            } catch (failure: JSchException) {
+                showMessage(sshError(failure))
+            } catch (_: java.io.IOException) {
+                showMessage(R.string.assist_key_error)
+            } finally {
+                pending?.disconnect()
+                connecting = false
+                updateControls()
+            }
+        }
+    }
+
+    private fun showMessage(@StringRes text: Int) {
+        Toast.makeText(this, text, Toast.LENGTH_LONG).show()
+    }
+
+    private fun LinearLayout.button(@StringRes label: Int, action: () -> Unit): Button =
+        Button(context).apply {
+            setText(label)
+            setOnClickListener { action() }
+            this@button.addView(this)
+        }
+
+    private fun LinearLayout.input(@StringRes label: Int, type: Int = InputType.TYPE_CLASS_TEXT): EditText {
+        addView(TextView(context).apply { setText(label) })
+        return EditText(context).apply {
+            inputType = type or if (type == InputType.TYPE_CLASS_TEXT) InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS else 0
+            setSingleLine()
+            contentDescription = getString(label)
+            this@input.addView(this)
+        }
+    }
+}
