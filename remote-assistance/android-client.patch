+
+abstract class LockProtectedActivity : ComponentActivity() {
+    private val appLock by lazy { AppLock(this) }
+
+    override fun onStart() {
+        super.onStart()
+        val protected = appLock.mode != AppLock.Mode.OFF
+        updateRecentsProtection(protected)
+        findViewById<View>(android.R.id.content).visibility =
+            if (protected && !AppLock.unlocked) View.INVISIBLE else View.VISIBLE
+    }
+
+    override fun onResume() {
+        super.onResume()
+        val locked = appLock.mode != AppLock.Mode.OFF && !AppLock.unlocked
+        findViewById<View>(android.R.id.content).visibility = if (locked) View.INVISIBLE else View.VISIBLE
+        if (locked && !AppLock.opening && !isFinishing) {
+            AppLock.opening = true
+            startActivity(Intent(this, AssistLockActivity::class.java))
+        }
+    }
+
+    override fun onStop() {
+        if (appLock.mode != AppLock.Mode.OFF) findViewById<View>(android.R.id.content).visibility = View.INVISIBLE
+        super.onStop()
+    }
+
+    protected fun updateRecentsProtection(protected: Boolean) {
+        if (android.os.Build.VERSION.SDK_INT >= 33) setRecentsScreenshotEnabled(!protected)
+    }
+}
+
+class AssistLockActivity : ComponentActivity() {
+    private val appLock by lazy { AppLock(this) }
+    private var cancellation: CancellationSignal? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        AppLock.opening = true
+        window.addFlags(WindowManager.LayoutParams.FLAG_SECURE)
+        val pad = (resources.displayMetrics.density * 24).toInt()
+        val layout = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(pad, pad * 3, pad, pad)
+            setBackgroundColor(getColor(R.color.assist_background))
+        }
+        layout.addView(TextView(this).apply {
+            setText(R.string.assist_locked)
+            textSize = 26f
+            setTextColor(getColor(R.color.assist_text))
+            setPadding(0, 0, 0, pad)
+        })
+        setContentView(layout)
+        onBackPressedDispatcher.addCallback(this, object : OnBackPressedCallback(true) {
+            override fun handleOnBackPressed() {
+                moveTaskToBack(true)
+                finish()
+            }
+        })
+        when (appLock.mode) {
+            AppLock.Mode.OFF -> unlock()
+            AppLock.Mode.ANDROID -> {
+                val message = TextView(this).apply { setTextColor(getColor(R.color.assist_text)) }
+                layout.addView(Button(this).apply {
+                    setText(R.string.assist_unlock_android)
+                    setOnClickListener {
+                        cancellation?.cancel()
+                        cancellation = authenticateAndroid(onUnlocked = ::unlock) {
+                            message.setText(R.string.assist_auth_unavailable)
+                        }
+                    }
+                })
+                layout.addView(message)
+            }
+            else -> {
+                val field = lockSecretField(this, appLock.mode, R.string.assist_unlock_secret)
+                layout.addView(field)
+                layout.addView(Button(this).apply {
+                    setText(R.string.assist_unlock)
+                    setOnClickListener {
+                        val value = field.text.toString()
+                        isEnabled = false
+                        lifecycleScope.launch {
+                            val success = withContext(Dispatchers.Default) { appLock.verify(value) }
+                            if (success) unlock() else {
+                                field.setText("")
+                                field.error = lockError(appLock)
+                                isEnabled = true
+                            }
+                        }
+                    }
+                })
+            }
+        }
+    }
+
+    private fun unlock() {
+        if (appLock.mode != AppLock.Mode.OFF && !lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED)) return
+        AppLock.unlocked = true
+        finish()
+    }
+
+    override fun onDestroy() {
+        cancellation?.cancel()
+        AppLock.opening = false
+        super.onDestroy()
+    }
+}
+
+internal fun ComponentActivity.canUseAndroidLock(): Boolean =
+    Build.VERSION.SDK_INT >= 30 && getSystemService(KeyguardManager::class.java).isDeviceSecure &&
+        getSystemService(BiometricManager::class.java).canAuthenticate(androidAuthenticators()) ==
+        BiometricManager.BIOMETRIC_SUCCESS
+
+@androidx.annotation.RequiresApi(30)
+private fun androidAuthenticators(): Int =
+    BiometricManager.Authenticators.BIOMETRIC_STRONG or BiometricManager.Authenticators.DEVICE_CREDENTIAL
+
+internal fun ComponentActivity.authenticateAndroid(
+    onUnlocked: () -> Unit,
+    onFailed: () -> Unit,
+): CancellationSignal? {
+    if (Build.VERSION.SDK_INT < 30 || !canUseAndroidLock()) {
+        onFailed()
+        return null
+    }
+    val cancellation = CancellationSignal()
+    BiometricPrompt.Builder(this).setTitle(getString(R.string.assist_unlock_android))
+        .setAllowedAuthenticators(androidAuthenticators())
+        .build()
+        .authenticate(cancellation, mainExecutor, object : BiometricPrompt.AuthenticationCallback() {
+            override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) = onUnlocked()
+            override fun onAuthenticationError(errorCode: Int, errString: CharSequence) = onFailed()
+        })
+    return cancellation
+}
+
+internal fun lockSecretField(activity: ComponentActivity, mode: AppLock.Mode, label: Int): EditText =
+    EditText(activity).apply {
+        setHint(label)
+        setSingleLine()
+        inputType = if (mode == AppLock.Mode.PIN) {
+            InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_VARIATION_PASSWORD
+        } else InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+        transformationMethod = PasswordTransformationMethod.getInstance()
+        isSaveEnabled = false
+    }
+
+internal fun ComponentActivity.lockError(lock: AppLock): String =
+    lock.retrySeconds().let { seconds ->
+        if (seconds > 0) getString(R.string.assist_lock_retry, seconds)
+        else getString(R.string.assist_wrong_local_secret)
+    }
