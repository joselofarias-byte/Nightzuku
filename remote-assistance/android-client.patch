+class RemoteAssistActivity : LockProtectedActivity() {
+    private val preferences by lazy { AssistPreferences(this) }
+    private val login by lazy { getSharedPreferences("relay_login", MODE_PRIVATE) }
+    private var role = AssistRole.OPERATOR
+    private var busy = false
+    private lateinit var form: LinearLayout
+    private lateinit var operator: RadioButton
+    private lateinit var assisted: RadioButton
+    private lateinit var action: Button
+    private lateinit var menu: Button
+    private lateinit var avatar: ImageButton
+    private lateinit var servers: Button
+    private lateinit var operatorName: Button
+    private lateinit var status: TextView
+    private lateinit var feedback: TextView
+    private lateinit var deviceNameRow: LinearLayout
+    private lateinit var passwordReveal: Button
+    private var selectedServer = ""
+    private lateinit var userInput: EditText
+    private lateinit var passwordInput: EditText
+    private lateinit var deviceName: EditText
+
+    private val notifications = registerForActivityResult(ActivityResultContracts.RequestPermission()) { allowed ->
+        if (allowed) activate() else message(R.string.assist_notifications_required)
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        role = savedInstanceState?.getString("role")?.let(AssistRole::valueOf)
+            ?: if (preferences.enabled || login.getBoolean("receiveRole", false)) AssistRole.DEVICE
+            else AssistRole.OPERATOR
+        val layout = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(20), dp(24), dp(20), dp(24))
+            isFocusableInTouchMode = true
+        }
+        val header = LinearLayout(this).apply {
+            gravity = Gravity.CENTER_VERTICAL
+            orientation = LinearLayout.HORIZONTAL
+        }
+        header.addView(label(R.string.app_name, 26f, bold = true).apply {
+            text = getString(R.string.assist_title, getString(R.string.app_name), BuildConfig.VERSION_NAME)
+            ViewCompat.setAccessibilityHeading(this, true)
+        }, LinearLayout.LayoutParams(0, -2, 1f))
+        avatar = ImageButton(this).apply {
+            setBackgroundResource(android.R.drawable.list_selector_background)
+            setPadding(dp(3), dp(3), dp(3), dp(3))
+            scaleType = android.widget.ImageView.ScaleType.FIT_CENTER
+            setOnClickListener { chooseAvatar() }
+        }
+        header.addView(avatar, LinearLayout.LayoutParams(dp(48), dp(48)))
+        menu = Button(this).apply {
+            text = "⋮"
+            textSize = 26f
+            contentDescription = getString(R.string.assist_menu)
+            setPadding(0, 0, 0, 0)
+            minWidth = dp(48)
+            minHeight = dp(48)
+            setTextColor(getColor(R.color.assist_accent))
+            background = RippleDrawable(
+                ColorStateList.valueOf(getColor(R.color.assist_border)), shape(R.color.assist_surface), null,
+            )
+            setOnClickListener { openMenu(this) }
+        }
+        header.addView(menu, LinearLayout.LayoutParams(dp(48), dp(48)).apply { marginStart = dp(8) })
+        layout.addView(header, LinearLayout.LayoutParams(-1, -2).apply { bottomMargin = dp(20) })
+        val modes = layout.card()
+        modes.addView(label(R.string.assist_mode, 14f, bold = true).apply {
+            ViewCompat.setAccessibilityHeading(this, true)
+            setPadding(dp(4), 0, 0, dp(6))
+        })
+        operator = modes.mode(R.string.assist_operator, AssistRole.OPERATOR)
+        assisted = modes.mode(R.string.assist_device, AssistRole.DEVICE)
+
+        val panel = layout.card()
+        status = label(R.string.assist_login_hint, 14f, tone = R.color.assist_muted).also(panel::addView)
+        operatorName = panel.button(R.string.assist_operator_name) { editOperatorName() }
+        servers = panel.button(R.string.assist_choose_server) { chooseServer(servers) }
+        form = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }.also(panel::addView)
+        userInput = form.field(R.string.assist_ssh_user, InputType.TYPE_CLASS_TEXT)
+        passwordInput = form.field(R.string.assist_password, PASSWORD_INPUT)
+        passwordReveal = form.button(R.string.assist_show_password) { setPasswordVisible(!passwordVisible()) }
+        deviceName = form.field(R.string.assist_device_name, InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_CAP_SENTENCES)
+        deviceNameRow = deviceName.parent as LinearLayout
+        feedback = label(R.string.assist_invalid, 14f, tone = R.color.assist_error).apply {
+            accessibilityLiveRegion = View.ACCESSIBILITY_LIVE_REGION_POLITE
+            visibility = View.GONE
+            setPadding(0, dp(10), 0, dp(4))
+        }.also(panel::addView)
+        action = panel.button(R.string.assist_sign_in, primary = true, callback = ::submit)
+        listOf(userInput, passwordInput, deviceName).forEach { field ->
+            field.doAfterTextChanged { field.error = null; feedback.visibility = View.GONE }
+        }
+        val page = ScrollView(this).apply {
+            setBackgroundColor(getColor(R.color.assist_background))
+            isFillViewport = true
+            addView(layout)
+        }
+        ViewCompat.setOnApplyWindowInsetsListener(page) { view, insets ->
+            val safe = insets.getInsets(WindowInsetsCompat.Type.systemBars() or WindowInsetsCompat.Type.displayCutout() or WindowInsetsCompat.Type.ime())
+            view.updatePadding(left = safe.left, top = safe.top, right = safe.right, bottom = safe.bottom)
+            insets
+        }
+        setContentView(page)
+        loadRole()
+        lifecycleScope.launch { AvailabilityService.status.collect { render() } }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        render()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        outState.putString("role", role.name)
+        super.onSaveInstanceState(outState)
+    }
+
+    private fun account(role: AssistRole = this.role): String =
+        if (role == AssistRole.DEVICE) "remote-device-01" else "remote-operator-01"
+
+    private fun server(): String = RelayLogin.resolveServer(login.getString("server.${role.name}", "").orEmpty())
+    private fun token(): String = login.getString("token", "").orEmpty()
+    private fun enrolled(): Boolean = server().isNotEmpty() &&
+        if (role == AssistRole.DEVICE) preferences.profile(role).isValid() else token().isNotEmpty()
+
+    private fun chooseRole(next: AssistRole) {
+        if (next == role || busy) return
+        role = next
+        login.edit().putBoolean("receiveRole", role == AssistRole.DEVICE).apply()
+        loadRole()
+    }
+
+    private fun loadRole() {
+        updateSelectedServer(RelayLogin.displayServer(server().ifBlank { login.getString("lastServer", "").orEmpty() }))
+        userInput.setText(login.getString("username.${role.name}", account()))
+        passwordInput.setText("")
+        setPasswordVisible(false)
+        deviceName.setText(login.getString("deviceName", Build.MODEL))
+        deviceNameRow.visibility = if (role == AssistRole.DEVICE) View.VISIBLE else View.GONE
+        render()
+    }
+
+    private fun render() {
+        val receive = role == AssistRole.DEVICE
+        val registered = enrolled()
+        updateAvatar()
+        updateMode(operator, !receive)
+        updateMode(assisted, receive)
+        listOf(servers, avatar, operatorName, userInput, passwordInput, passwordReveal, deviceName)
+            .forEach { it.isEnabled = !busy }
+        operatorName.visibility = if (receive) View.VISIBLE else View.GONE
+        form.visibility = if (registered) View.GONE else View.VISIBLE
+        status.text = AvailabilityService.statusText(this, when {
+            busy -> R.string.assist_connecting
+            receive && preferences.enabled -> AvailabilityService.status.value
+            receive && registered -> R.string.assist_disabled
+            !receive && registered -> R.string.assist_operator_ready
+            else -> R.string.assist_login_hint
+        })
+        action.setText(when {
+            receive && preferences.enabled -> R.string.assist_disable
+            receive && registered -> R.string.assist_enable
+            registered -> R.string.assist_devices
+            else -> R.string.assist_sign_in
+        })
+        action.isEnabled = !busy
+        menu.isEnabled = !busy
+    }
+
+    private fun editOperatorName() {
+        val fields = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(20), dp(8), dp(20), dp(8))
+        }
+        val name = fields.field(R.string.assist_operator_name, InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_CAP_WORDS)
+        name.filters = arrayOf(android.text.InputFilter.LengthFilter(60))
+        name.setText(preferences.operatorName)
+        AlertDialog.Builder(this).setTitle(R.string.assist_operator_name)
+            .setMessage(R.string.assist_operator_name_hint)
+            .setView(fields)
+            .setPositiveButton(R.string.assist_save_account) { _, _ ->
+                preferences.operatorName = name.text.toString().trim().filterNot(Char::isISOControl)
+                if (preferences.enabled) {
+                    runCatching { AvailabilityService.start(this) }.onFailure { message(R.string.assist_service_error) }
+                }
+                render()
+            }
+            .setNegativeButton(android.R.string.cancel, null).show()
+    }
+
+    private fun submit() {
+        if (role == AssistRole.DEVICE && preferences.enabled) {
+            AvailabilityService.stop(this)
+            render()
+            return
+        }
+        if (enrolled()) {
+            if (role == AssistRole.DEVICE) enableAvailability() else refreshDevices()
+            return
+        }
+        val host = selectedServer
+        val username = userInput.text.toString().trim()
+        val password = passwordInput.text.toString()
+        val name = deviceName.text.toString().trim()
+        val selectedRole = role
+        feedback.visibility = View.GONE
+        if (!RelayLogin.validServer(host)) {
+            message(R.string.assist_bad_server)
+            return
+        }
+        val invalid = listOfNotNull(
+            (userInput to R.string.assist_bad_username).takeUnless { USERNAME.matches(username) },
+            (passwordInput to R.string.assist_bad_password).takeUnless { password.length in 1..256 },
+            (deviceName to R.string.assist_bad_device_name).takeIf { selectedRole == AssistRole.DEVICE && name.length !in 1..60 },
+        )
+        if (invalid.isNotEmpty()) {
+            invalid.forEach { (field, error) -> field.error = getString(error) }
+            invalid.first().first.requestFocus()
+            return
+        }
+        ViewCompat.getWindowInsetsController(form)?.hide(WindowInsetsCompat.Type.ime())
+        setPasswordVisible(false)
+        runNetwork {
+            val response = withContext(Dispatchers.IO) {
+                val key = AssistSsh.publicKey(applicationContext, selectedRole)
+                RelayLogin.request(host, "login", JSONObject()
+                    .put("username", username).put("password", password).put("name", name).put("publicKey", key)
+                    .put("role", account(selectedRole)).put("websocket", RelayLogin.usesWebSocket(host)))
+            }
+            val edit = login.edit().putString("server.${selectedRole.name}", host)
+                .putString("username.${selectedRole.name}", username).putString("lastServer", host)
+            rememberServer(edit, host)
+            if (selectedRole == AssistRole.DEVICE) {
+                preferences.save(selectedRole, RelayLogin.profile(response, host, account(selectedRole)))
+                edit.putString("deviceName", name)
+            } else {
+                edit.putString("token", response.getString("token"))
+                    .putBoolean("admin", response.optBoolean("admin", username == account(selectedRole)))
+            }
+            edit.apply()
+            passwordInput.setText("")
+            if (selectedRole == AssistRole.OPERATOR) showDevices(response)
+        }
+    }
+
+    private fun logOut() {
+        if (role == AssistRole.DEVICE) AvailabilityService.stop(this)
+        val edit = login.edit().remove("server.${role.name}")
+        if (role == AssistRole.OPERATOR) edit.remove("token").remove("admin")
+        edit.apply()
+        loadRole()
+    }
+
+    private fun customServers() = login.getStringSet("customServers", emptySet()).orEmpty()
+
+    private fun rememberServer(edit: SharedPreferences.Editor, host: String) {
+        val knownHosts = customServers()
+        if (host != RelayLogin.displayServer("") && host != RelayLogin.TAILSCALE_SERVER && host !in knownHosts) {
+            edit.putStringSet("customServers", knownHosts + host)
+        }
+    }
+
+    private fun updateSelectedServer(host: String) {
+        selectedServer = host
+        servers.text = getString(R.string.assist_server_selected, host)
+    }
+
+    private fun chooseServer(anchor: View) {
+        val principal = RelayLogin.displayServer("")
+        val known = linkedMapOf(principal to getString(R.string.assist_server_primary, principal))
+        known[RelayLogin.TAILSCALE_SERVER] = getString(R.string.assist_server_tailscale)
+        (customServers() + selectedServer).sorted().forEach { host ->
+            if (RelayLogin.validServer(host)) known.putIfAbsent(host, host)
+        }
+        val choices = known.keys.toList()
+        PopupMenu(this, anchor).apply {
+            known.values.forEachIndexed { index, title -> menu.add(0, index, index, title) }
+            setOnMenuItemClickListener { item ->
+                selectServer(choices[item.itemId])
+                true
+            }
+            show()
+        }
+    }
