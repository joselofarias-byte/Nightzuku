#!/system/bin/sh
# TAPI - Nightzuku command-line bridge for Termux-compatible terminals.
# Uses the same dynamic terminal identity contract as the fork rish wrapper.

ANDROID_BIN=/system/bin
PM="$ANDROID_BIN/pm"
UNZIP="$ANDROID_BIN/unzip"
GETPROP="$ANDROID_BIN/getprop"
APP_PROCESS="$ANDROID_BIN/app_process"
MKDIR="$ANDROID_BIN/mkdir"
CHMOD="$ANDROID_BIN/chmod"
MV="$ANDROID_BIN/mv"
RM="$ANDROID_BIN/rm"
MKTEMP="$ANDROID_BIN/mktemp"
SED="$ANDROID_BIN/sed"
CP="$ANDROID_BIN/cp"

MANAGER_PKG="com.joselofarias.nightzuku"

[ -z "$HOME" ] && HOME=/data/local/tmp
TAPI_DIR="$HOME/.tapi"
DEX="$TAPI_DIR/rish_shizuku.dex"
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

if [ ! -f "$DEX" ]; then
  "$MKDIR" -p "$TAPI_DIR"
  if [ -f "$SCRIPT_DIR/rish_shizuku.dex" ]; then
    "$CP" "$SCRIPT_DIR/rish_shizuku.dex" "$DEX" 2>/dev/null
  fi
fi

if [ ! -f "$DEX" ]; then
  "$MKDIR" -p "$TAPI_DIR"
  apk_path=$("$PM" path "$MANAGER_PKG" 2>/dev/null | "$SED" -n '1s/^package://p')
  if [ -n "$apk_path" ] && [ -f "$apk_path" ]; then
    tmpdir=$("$MKTEMP" -d -p "$TAPI_DIR" 2>/dev/null || echo "$TAPI_DIR/tmp_$$")
    "$MKDIR" -p "$tmpdir" 2>/dev/null
    "$UNZIP" -o "$apk_path" "assets/rish_shizuku.dex" -d "$tmpdir" >/dev/null 2>&1
    if [ -f "$tmpdir/assets/rish_shizuku.dex" ]; then
      "$MV" "$tmpdir/assets/rish_shizuku.dex" "$DEX"
    fi
    "$RM" -rf "$tmpdir"
  fi
fi

if [ ! -f "$DEX" ]; then
  echo "tapi: Cannot find rish_shizuku.dex" >&2
  echo "tapi: Make sure Nightzuku ($MANAGER_PKG) is installed." >&2
  exit 1
fi

sdk=$("$GETPROP" ro.build.version.sdk 2>/dev/null)
case "$sdk" in
  3[4-9]|4[0-9]) "$CHMOD" 400 "$DEX" 2>/dev/null ;;
esac

if [ -z "$RISH_APPLICATION_ID" ]; then
  case "$TERMUX_APP__PACKAGE_NAME" in
    *.*) RISH_APPLICATION_ID="$TERMUX_APP__PACKAGE_NAME" ;;
  esac
fi

if [ -z "$RISH_APPLICATION_ID" ]; then
  case "$PREFIX" in
    /data/data/*/files/usr)
      RISH_APPLICATION_ID=${PREFIX#/data/data/}
      RISH_APPLICATION_ID=${RISH_APPLICATION_ID%/files/usr}
      ;;
    /data/user/*/*/files/usr)
      RISH_APPLICATION_ID=$(printf '%s\n' "$PREFIX" | "$SED" -n 's#^/data/user/[0-9][0-9]*/\([^/]*\)/files/usr$#\1#p')
      ;;
  esac
fi

if [ -z "$RISH_APPLICATION_ID" ]; then
  case "$HOME" in
    /data/data/*/files/home)
      RISH_APPLICATION_ID=${HOME#/data/data/}
      RISH_APPLICATION_ID=${RISH_APPLICATION_ID%/files/home}
      ;;
    /data/user/*/*/files/home)
      RISH_APPLICATION_ID=$(printf '%s\n' "$HOME" | "$SED" -n 's#^/data/user/[0-9][0-9]*/\([^/]*\)/files/home$#\1#p')
      ;;
  esac
fi

[ -z "$RISH_APPLICATION_ID" ] && RISH_APPLICATION_ID="com.termux"
export RISH_APPLICATION_ID

if [ "$RISH_DEBUG" = "1" ]; then
  echo "tapi: application id = $RISH_APPLICATION_ID" >&2
  echo "tapi: dex = $DEX" >&2
fi

unset LD_LIBRARY_PATH
exec "$APP_PROCESS" -Djava.class.path="$DEX" /system/bin --nice-name=tapi rikka.shizuku.shell.TapiManager "$@"
